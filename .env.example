# Application Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=dev-insecure-secret-key-change-in-production
API_V1_STR=/api/v1

# Database Configuration (Use dedicated non-superuser credentials in production)
DATABASE_URL=postgresql+psycopg://quant_user:quant_password@localhost:5432/quant_dashboard

# Security & CORS Settings (Comma-separated list of trusted origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE_STANDARD=300
RATE_LIMIT_PER_MINUTE_EXPENSIVE=60

# Market Data Provider Keys (Optional / placeholder)
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=
